{
  "id": "./",
  "name": "SIGNAL//BREAK",
  "short_name": "SignalBreak",
  "description": "A real-time party-based roguelite deckbuilding JRPG.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
